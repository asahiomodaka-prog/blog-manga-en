---
import Layout from '../layouts/BlogPost.astro';
import { CONTACT_FORM_URL } from '../consts';

const isPlaceholder = CONTACT_FORM_URL.includes('XXXXXXXXXXXXX');
---

<Layout
	title="Contact Us"
	description="Get in touch with the editorial team at Midnight Manga Vault for inquiries, feedback, review requests, or business opportunities."
	pubDate={new Date('August 19 2026')}
>
	<p style="font-size: 1.05rem; line-height: 1.7; color: #475569; margin-bottom: 2rem;">
		Thank you for visiting <strong>Midnight Manga Vault</strong>. Whether you have editorial feedback, a manga review suggestion, questions regarding collectible editions, copyright inquiries, or advertising proposals, we welcome your message.
	</p>

	<!-- Direct Editorial Email Card -->
	<div class="contact-card" style="margin: 2rem 0; padding: 2rem; background: linear-gradient(135deg, #f8fafc, #f1f5f9); border: 1px solid #e2e8f0; border-left: 5px solid #8b5cf6; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
		<h3 style="margin: 0 0 1rem 0; font-size: 1.25rem; color: #1e293b; display: flex; align-items: center; gap: 0.5rem;">
			✉️ Direct Editorial Email
		</h3>
		<p style="margin: 0 0 1.2rem 0; font-size: 0.95rem; color: #334155; line-height: 1.6;">
			For prompt communication, you can email our editorial team directly at:
		</p>
		<div style="margin: 1rem 0; padding: 12px 18px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; display: inline-block;">
			<a href="mailto:asahiomodaka@gmail.com" style="font-size: 1.15rem; font-weight: bold; color: #7c3aed; text-decoration: none;">
				asahiomodaka@gmail.com
			</a>
		</div>
		<ul style="margin: 1.2rem 0 0 0; padding-left: 1.2rem; font-size: 0.88rem; color: #64748b; line-height: 1.65;">
			<li><strong>Response Time</strong>: We strive to reply to all legitimate inquiries within 24 to 48 business hours.</li>
			<li><strong>Inquiry Types</strong>: Content feedback, licensing & copyright inquiries, business partnerships, and affiliate inquiries.</li>
		</ul>
	</div>

	<!-- Online Inquiry Form Section -->
	<div style="margin-top: 3rem;">
		<h3 style="font-size: 1.25rem; color: #1e293b; margin-bottom: 0.75rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem;">
			📝 Web Inquiry Form
		</h3>
		<p style="font-size: 0.95rem; color: #64748b; margin-bottom: 1.5rem;">
			Alternatively, you may submit your inquiry using our secure form below:
		</p>

		<div class="form-container">
			<iframe
				src={CONTACT_FORM_URL}
				width="100%"
				height="800"
				style="border: none; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);"
			>
				Loading inquiry form…
			</iframe>
		</div>
	</div>
</Layout>

<style>
	.form-container {
		width: 100%;
		display: flex;
		justify-content: center;
	}
</style>
