---
import Layout from '../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
	title="Complete Review Archive"
	description="Explore the complete archive of manga reviews, anime analyses, and figure guides on Midnight Manga Vault."
>
	<p class="archive-intro">
		Browse all published reviews, deep dives, and articles in chronological order.
	</p>

	<ul class="archive-list">
		{
			posts.map((post) => (
				<li>
					<span class="archive-date">
						<FormattedDate date={post.data.pubDate} />
					</span>
					<a href={`/blog/${post.id}/`} class="archive-title-link">
						{post.data.title}
					</a>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.archive-intro {
		color: #71717a;
		font-size: 0.95rem;
		margin-bottom: 2rem;
		line-height: 1.7;
	}
	.archive-list {
		list-style-type: none;
		padding: 0;
		margin: 2rem 0;
	}
	.archive-list li {
		display: flex;
		gap: 2rem;
		padding: 1rem 0;
		border-bottom: 1px dashed #e4e4e7;
		align-items: center;
	}
	.archive-date {
		font-size: 0.85rem;
		color: #71717a;
		font-weight: 500;
		font-family: 'Outfit', sans-serif;
		min-width: 100px;
	}
	.archive-title-link {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		line-height: 1.4;
	}
	.archive-title-link:hover {
		color: var(--accent-dark);
		text-decoration: underline;
	}
</style>
