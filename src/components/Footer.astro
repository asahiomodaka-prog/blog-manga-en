---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="network-links" style="margin-bottom: 1.5em; padding-bottom: 1.2em; border-bottom: 1px solid rgba(var(--gray), 0.2);">
		<span style="display: block; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.6em; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(var(--gray));">AriaWriter Media Network</span>
		<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1.2em; font-size: 0.85rem;">
			<a href="https://coffeegurasi.ariawriter.com/" style="text-decoration: none; color: rgb(var(--gray));">☕ Coffee Lifestyle</a>
			<a href="https://yohukashinomeisakudana.ariawriter.com/" style="text-decoration: none; color: rgb(var(--gray));">📚 Japanese Manga Classics</a>
			<a href="https://saikyotakutore.ariawriter.com/" style="text-decoration: none; color: rgb(var(--gray));">🏋️ Home Workout Lab</a>
			<a href="https://en-manga.ariawriter.com/" style="text-decoration: none; color: rgb(var(--gray-dark)); font-weight: 500;">🌐 Midnight Manga Vault</a>
		</div>
	</div>
	<div class="footer-links">
		<a href="/privacy">Privacy Policy</a>
		<a href="/disclaimer">Disclaimer & About</a>
		<a href="/contact">Contact</a>
	</div>
	&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-bottom: 1.5em;
	}
	.footer-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.footer-links a:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
</style>
